{
  "name": "jchat-server",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "dev:meeting": "cd ../meeting && npm run dev",
    "dev:landing": "cd ../landing && npm run dev",
    "dev": "concurrently 'npm:dev:server' 'npm:dev:client' 'npm:dev:meeting' 'npm:dev:landing'",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json && tsc-alias -p tsconfig.server.json --resolve-full-paths && node scripts/copy-runtime-assets.mjs",
    "build:meeting": "npm --prefix ../meeting run build",
    "build:landing": "npm --prefix ../landing run build",
    "build": "npm run build:client && npm run build:meeting && npm run build:landing && npm run build:server",
    "start": "node dist/server/server/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json",
    "precheck": "node scripts/precheck.mjs",
    "migrate": "node scripts/run-migrations.mjs",
    "create-user": "node scripts/create-local-user.mjs",
    "seed:nuwa": "tsx server/scripts/import-nuwa-examples.ts",
    "seed:local": "node scripts/seed-local.mjs",
    "bootstrap": "npm run migrate && npm run create-user && npm run seed:local"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.112",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@node-rs/argon2": "^2.0.2",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-popover": "^1.1.6",
    "@radix-ui/react-tooltip": "^1.1.8",
    "@supabase/supabase-js": "^2.90.1",
    "@tanstack/react-query": "^5.90.17",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.45.2",
    "express": "^4.18.2",
    "express-rate-limit": "^8.5.2",
    "jose": "^6.2.3",
    "lucide-react": "^0.487.0",
    "markdown-it": "^14.1.1",
    "multer": "^2.2.0",
    "pg": "^8.13.0",
    "pino": "^9.5.0",
    "pino-pretty": "^11.2.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "7.18.4",
    "tailwind-merge": "^2.5.4",
    "ws": "^8.18.0",
    "zod": "^4.0.0",
    "zustand": "^5.0.10"
  },
  "pnpm": {
    "supportedArchitectures": {
      "os": [
        "linux",
        "darwin"
      ],
      "cpu": [
        "x64",
        "arm64"
      ],
      "libc": [
        "glibc"
      ]
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.58.1",
    "@slack/socket-mode": "^2.0.7",
    "@slack/web-api": "^7.17.0",
    "@testing-library/jest-dom": "^6.6.5",
    "@testing-library/react": "^16.1.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.21",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.10",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/supertest": "^7.2.0",
    "@types/ws": "^8.5.10",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "autoprefixer": "^10.4.18",
    "concurrently": "^8.2.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.35",
    "supertest": "^7.2.2",
    "tailwindcss": "^3.4.17",
    "tsc-alias": "^1.9.7",
    "tsx": "^4.7.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.71.2",
    "vite": "6.4.4",
    "vitest": "5.0.5"
  },
  "overrides": {
    "qs": "6.16.1",
    "postcss-selector-parser": "7.1.6"
  }
}
