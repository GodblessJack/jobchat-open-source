JCHAT_PORT=5272
JCHAT_SESSIONS_ROOT=/data/jchat-sessions
NODE_ENV=development

# Anthropic / Claude（必填）
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=

# OpenAI（用于 embedding；不提供则用 stub-zero-vector 模式）
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Qwen-Omni Realtime（内置视频通话 ws-proxy.ts 使用）
ALIBABA_DASHSCOPE_API_KEY=
QWEN_OMNI_WS_URL=wss://dashscope.aliyuncs.com/api-ws/v1/realtime?model=qwen3.5-omni-plus-realtime

# 本地 PostgreSQL（密码需与根目录 .env 的 POSTGRES_PASSWORD 一致）
DATABASE_URL=postgresql://postgres:replace-me@127.0.0.1:5432/jobchat
# 使用 `openssl rand -hex 64` 分别生成两个不同的随机值
LOCAL_JWT_ACCESS_SECRET=
LOCAL_JWT_REFRESH_SECRET=
FILES_ROOT=/data/jobchat/files
AUTH_TRANSITION=0

# 本地开发账号（仅在 create-user / seed:local 时使用）
JCHAT_LOCAL_USERNAME=admin
JCHAT_LOCAL_PASSWORD=

# 可调参数（默认值见 server/config.ts）
JCHAT_GROUP_MEMBER_LIMIT=20
JCHAT_CONCURRENT_AGENTS_PER_CONV=5
JCHAT_CONCURRENT_AGENTS_PER_USER=5
JCHAT_GLOBAL_WORKER_LIMIT=30
JCHAT_WORKER_IDLE_MS=600000
JCHAT_DEBATE_DEFAULT_ROUNDS=6
JCHAT_DEBATE_MAX_PANELISTS=5
JCHAT_UPLOAD_MAX_SIZE=52428800
JCHAT_MEMORY_TOP_K=8
JCHAT_EMBEDDING_PROVIDER=
JCHAT_EMBEDDING_MODEL=text-embedding-3-small
JCHAT_MODERATOR_MODEL=claude-haiku-4-5-20251001

# Slack notifications（可选；不配置则静默跳过）
SLACK_WEBHOOK_URL=
